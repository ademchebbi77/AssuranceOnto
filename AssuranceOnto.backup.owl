        <montantVerse rdf:datatype="&xsd;decimal">5200</montantVerse>
        <dateVersement rdf:datatype="&xsd;dateTime">2026-06-10T00:00:00</dateVersement>
        <selonBareme rdf:resource="http://www.example.org/assuranceonto#Bareme_Collision"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.example.org/assuranceonto#Indemnisation_002">
        <rdf:type rdf:resource="http://www.example.org/assuranceonto#Indemnisation"/>
        <montantVerse rdf:datatype="&xsd;decimal">45000</montantVerse>
        <dateVersement rdf:datatype="&xsd;dateTime">2026-07-25T00:00:00</dateVersement>
        <selonBareme rdf:resource="http://www.example.org/assuranceonto#Bareme_Incendie"/>
    </owl:NamedIndividual>
    <!-- ================================================================ -->
    <!--  RÈGLES SWRL                                                   -->
    <!-- ================================================================ -->

    <!-- R1 : Sinistre(?s) ^ concerneContrat(?s,?c) ^ comporteGarantie(?c,?g) ^ couvreDommage(?g,?d) ^ causeDommage(?s,?d) -> SinistreCouvert(?s) -->
    <!-- R2 : Sinistre(?s) ^ concerneContrat(?s,?c) ^ contientClause(?c,?cl) ^ excluDommage(?cl,?d) ^ causeDommage(?s,?d) -> SinistreExclu(?s) -->
    <!-- R3 : SinistreGrave(?s) -> SinistreAExpertiser(?s) -->

    <swrl:Variable rdf:about="urn:swrl#s"/>
    <swrl:Variable rdf:about="urn:swrl#c"/>
    <swrl:Variable rdf:about="urn:swrl#g"/>
    <swrl:Variable rdf:about="urn:swrl#d"/>
    <swrl:Variable rdf:about="urn:swrl#cl"/>

    <swrl:Imp>
        <rdfs:label>R1_SinistreCouvert</rdfs:label>
        <swrl:body><swrl:AtomList><rdf:first><swrl:ClassAtom><swrl:classPredicate rdf:resource="http://www.example.org/assuranceonto#Sinistre"/><swrl:argument1 rdf:resource="urn:swrl#s"/></swrl:ClassAtom></rdf:first><rdf:rest><swrl:AtomList><rdf:first><swrl:IndividualPropertyAtom><swrl:propertyPredicate rdf:resource="http://www.example.org/assuranceonto#concerneContrat"/><swrl:argument1 rdf:resource="urn:swrl#s"/><swrl:argument2 rdf:resource="urn:swrl#c"/></swrl:IndividualPropertyAtom></rdf:first><rdf:rest><swrl:AtomList><rdf:first><swrl:IndividualPropertyAtom><swrl:propertyPredicate rdf:resource="http://www.example.org/assuranceonto#comporteGarantie"/><swrl:argument1 rdf:resource="urn:swrl#c"/><swrl:argument2 rdf:resource="urn:swrl#g"/></swrl:IndividualPropertyAtom></rdf:first><rdf:rest><swrl:AtomList><rdf:first><swrl:IndividualPropertyAtom><swrl:propertyPredicate rdf:resource="http://www.example.org/assuranceonto#couvreDommage"/><swrl:argument1 rdf:resource="urn:swrl#g"/><swrl:argument2 rdf:resource="urn:swrl#d"/></swrl:IndividualPropertyAtom></rdf:first><rdf:rest><swrl:AtomList><rdf:first><swrl:IndividualPropertyAtom><swrl:propertyPredicate rdf:resource="http://www.example.org/assuranceonto#causeDommage"/><swrl:argument1 rdf:resource="urn:swrl#s"/><swrl:argument2 rdf:resource="urn:swrl#d"/></swrl:IndividualPropertyAtom></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></swrl:AtomList></rdf:rest></swrl:AtomList></rdf:rest></swrl:AtomList></rdf:rest></swrl:AtomList></rdf:rest></swrl:AtomList></swrl:body>
        <swrl:head><swrl:AtomList><rdf:first><swrl:ClassAtom><swrl:classPredicate rdf:resource="http://www.example.org/assuranceonto#SinistreCouvert"/><swrl:argument1 rdf:resource="urn:swrl#s"/></swrl:ClassAtom></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></swrl:AtomList></swrl:head>
    </swrl:Imp>

    <swrl:Imp>
        <rdfs:label>R2_SinistreExclu</rdfs:label>
        <swrl:body><swrl:AtomList><rdf:first><swrl:ClassAtom><swrl:classPredicate rdf:resource="http://www.example.org/assuranceonto#Sinistre"/><swrl:argument1 rdf:resource="urn:swrl#s"/></swrl:ClassAtom></rdf:first><rdf:rest><swrl:AtomList><rdf:first><swrl:IndividualPropertyAtom><swrl:propertyPredicate rdf:resource="http://www.example.org/assuranceonto#concerneContrat"/><swrl:argument1 rdf:resource="urn:swrl#s"/><swrl:argument2 rdf:resource="urn:swrl#c"/></swrl:IndividualPropertyAtom></rdf:first><rdf:rest><swrl:AtomList><rdf:first><swrl:IndividualPropertyAtom><swrl:propertyPredicate rdf:resource="http://www.example.org/assuranceonto#contientClause"/><swrl:argument1 rdf:resource="urn:swrl#c"/><swrl:argument2 rdf:resource="urn:swrl#cl"/></swrl:IndividualPropertyAtom></rdf:first><rdf:rest><swrl:AtomList><rdf:first><swrl:IndividualPropertyAtom><swrl:propertyPredicate rdf:resource="http://www.example.org/assuranceonto#excluDommage"/><swrl:argument1 rdf:resource="urn:swrl#cl"/><swrl:argument2 rdf:resource="urn:swrl#d"/></swrl:IndividualPropertyAtom></rdf:first><rdf:rest><swrl:AtomList><rdf:first><swrl:IndividualPropertyAtom><swrl:propertyPredicate rdf:resource="http://www.example.org/assuranceonto#causeDommage"/><swrl:argument1 rdf:resource="urn:swrl#s"/><swrl:argument2 rdf:resource="urn:swrl#d"/></swrl:IndividualPropertyAtom></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></swrl:AtomList></rdf:rest></swrl:AtomList></rdf:rest></swrl:AtomList></rdf:rest></swrl:AtomList></rdf:rest></swrl:AtomList></swrl:body>
        <swrl:head><swrl:AtomList><rdf:first><swrl:ClassAtom><swrl:classPredicate rdf:resource="http://www.example.org/assuranceonto#SinistreExclu"/><swrl:argument1 rdf:resource="urn:swrl#s"/></swrl:ClassAtom></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></swrl:AtomList></swrl:head>
    </swrl:Imp>

    <swrl:Imp>
        <rdfs:label>R3_SinistreGraveAExpertiser</rdfs:label>
        <swrl:body><swrl:AtomList><rdf:first><swrl:ClassAtom><swrl:classPredicate rdf:resource="http://www.example.org/assuranceonto#SinistreGrave"/><swrl:argument1 rdf:resource="urn:swrl#s"/></swrl:ClassAtom></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></swrl:AtomList></swrl:body>
        <swrl:head><swrl:AtomList><rdf:first><swrl:ClassAtom><swrl:classPredicate rdf:resource="http://www.example.org/assuranceonto#SinistreAExpertiser"/><swrl:argument1 rdf:resource="urn:swrl#s"/></swrl:ClassAtom></rdf:first><rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/></swrl:AtomList></swrl:head>
    </swrl:Imp>

</rdf:RDF>
